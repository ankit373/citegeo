{
  "name": "citegeo",
  "version": "0.2.0",
  "private": true,
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/ankit373/citegeo.git"
  },
  "type": "module",
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "audit": "tsx src/cli.ts audit",
    "server": "tsx src/product/product-server.ts",
    "schedule:worker": "tsx src/product/scheduling/schedule-worker.ts",
    "schedule": "tsx src/cli.ts schedule",
    "projects": "tsx src/cli.ts projects",
    "import-runs": "tsx src/cli.ts import-runs",
    "monitor:create": "tsx src/cli.ts monitor-create",
    "monitor:run": "tsx src/cli.ts monitor-run",
    "monitor:due": "tsx src/cli.ts monitor-due",
    "monitor:worker": "tsx src/cli.ts monitor-worker",
    "self-check": "npm run build && node --test dist/**/*.test.js",
    "test:phase1-browser": "playwright test --config playwright.config.ts",
    "test:phase2-browser": "playwright test --config playwright.phase2.config.ts",
    "test:phase3-browser": "playwright test --config playwright.phase3.config.ts",
    "test:phase4-browser": "playwright test --config playwright.phase4.config.ts",
    "test:phase5-browser": "playwright test --config playwright.phase5.config.ts",
    "freeze:phase5": "tsx scripts/validate-phase5.ts freeze",
    "verify:phase5": "tsx scripts/validate-phase5.ts verify",
    "test:phase5-unit": "tsx scripts/run-phase5-unit.ts",
    "freeze:phase4": "tsx scripts/validate-phase4.ts freeze",
    "verify:phase4-freeze": "tsx scripts/validate-phase4.ts verify",
    "prepare:phase4-real-report": "tsx scripts/prepare-phase4-real-report.ts",
    "validate:phase4": "tsx scripts/run-phase4-validation.ts",
    "finalize:phase4": "tsx scripts/finalize-phase4-validation.ts",
    "validate:phase2-source": "tsx scripts/validate-phase2-source.ts",
    "freeze:phase3": "tsx scripts/validate-phase3-real.ts --freeze",
    "validate:phase3-real": "tsx scripts/validate-phase3-real.ts",
    "freeze:phase2": "tsx scripts/freeze-phase2.ts freeze",
    "verify:phase2-freeze": "tsx scripts/freeze-phase2.ts verify",
    "verify:real": "tsx src/cli.ts verify-real --provider openrouter --model openai/gpt-4o-mini",
    "test": "npm run self-check",
    "check:scripts": "node scripts/check-emitted-scripts.mjs",
    "check:docs": "node scripts/check-doc-links.mjs",
    "check:all": "npm run self-check && npm run check:scripts && npm run check:docs",
    "build:site": "npm run build && node scripts/build-site.mjs",
    "demand:index": "npm run build && node scripts/index-demand-corpus.mjs"
  },
  "dependencies": {
    "cheerio": "^1.2.0",
    "cron-parser": "^5.10.1",
    "linkify-it": "^6.1.0",
    "marked": "^18.0.13",
    "nodemailer": "^10.0.10"
  },
  "devDependencies": {
    "@playwright/test": "^1.63.0",
    "@types/node": "^24.13.5",
    "@types/nodemailer": "^8.0.2",
    "tsx": "^4.20.5",
    "typescript": "^6.0.3"
  },
  "engines": {
    "node": ">=22"
  }
}
