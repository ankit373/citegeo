{
  "name": "citegeo",
  "version": "0.6.0",
  "private": true,
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/ankit373/citegeo.git"
  },
  "type": "module",
  "scripts": {
    "build": "tsc -p tsconfig.json && npm run build:css",
    "build:css": "tailwindcss -i src/ui/theme.css -o dist/src/ui/app/app.css --minify",
    "build:site": "npm run build && node scripts/build-site.mjs",
    "lint": "biome lint src test e2e scripts",
    "self-check": "npm run build && node --test dist/**/*.test.js",
    "test": "npm run self-check",
    "check:scripts": "node scripts/check-emitted-scripts.mjs",
    "check:docs": "node scripts/check-doc-links.mjs",
    "check:theme": "node scripts/check-theme-tokens.mjs",
    "check:all": "npm run lint && npm run self-check && npm run check:scripts && npm run check:docs && npm run check:theme",
    "test:browser:projects": "playwright test --config playwright.projects.config.ts",
    "test:browser:configuration": "playwright test --config playwright.configuration.config.ts",
    "test:browser:recognition": "playwright test --config playwright.recognition.config.ts",
    "test:browser:reports": "playwright test --config playwright.reports.config.ts",
    "test:browser:measurements": "playwright test --config playwright.measurements.config.ts",
    "server": "tsx src/product/product-server.ts",
    "schedule": "tsx src/cli.ts schedule",
    "schedule:worker": "tsx src/product/scheduling/schedule-worker.ts",
    "monitor:create": "tsx src/cli.ts monitor-create",
    "monitor:run": "tsx src/cli.ts monitor-run",
    "monitor:due": "tsx src/cli.ts monitor-due",
    "monitor:worker": "tsx src/cli.ts monitor-worker",
    "audit": "tsx src/cli.ts audit",
    "projects": "tsx src/cli.ts projects",
    "import-runs": "tsx src/cli.ts import-runs",
    "verify:real": "tsx src/cli.ts verify-real --provider openrouter --model openai/gpt-4o-mini",
    "demand:index": "npm run build && node scripts/index-demand-corpus.mjs",
    "demand:explore": "npm run build && node scripts/explore-conversations.mjs"
  },
  "dependencies": {
    "cheerio": "^1.2.0",
    "cron-parser": "^5.10.2",
    "linkify-it": "^6.1.0",
    "marked": "^18.1.1",
    "nodemailer": "^10.1.0"
  },
  "devDependencies": {
    "@biomejs/biome": "2.6.4",
    "@playwright/test": "^1.64.0",
    "@tailwindcss/cli": "^4.3.3",
    "@types/node": "^24.19.2",
    "@types/nodemailer": "^8.0.2",
    "tailwindcss": "^4.3.3",
    "tsx": "^4.23.15",
    "typescript": "^6.0.3"
  },
  "engines": {
    "node": ">=22"
  }
}
