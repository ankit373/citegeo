{
  "$schema": "https://raw.githubusercontent.com/googleapis/release-please/main/schemas/config.json",
  "pull-request-header": "Release PR. It merges once the owner approves it.",
  "pull-request-footer": "Merging this tags the release, publishes its image and runs the smoke test.",
  "packages": {
    ".": {
      "release-type": "node",
      "package-name": "citegeo",
      "changelog-path": "CHANGELOG.md",
      "include-component-in-tag": false,
      "include-v-in-tag": true,
      "draft": false,
      "prerelease": false
    }
  },
  "changelog-sections": [
    { "type": "feat", "section": "Added" },
    { "type": "fix", "section": "Fixed" },
    { "type": "perf", "section": "Changed" },
    { "type": "revert", "section": "Reverted" },
    { "type": "refactor", "section": "Internal", "hidden": true },
    { "type": "chore", "section": "Chores", "hidden": true },
    { "type": "docs", "section": "Docs", "hidden": true },
    { "type": "ci", "section": "CI", "hidden": true },
    { "type": "test", "section": "Tests", "hidden": true },
    { "type": "build", "section": "Build", "hidden": true }
  ]
}
