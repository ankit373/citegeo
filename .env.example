# Any one of these is enough to run. Set the ones you have; the Setup page
# reports what each can actually do before a run rather than during one.

# An aggregator over many vendors, billed from a prepaid balance. Paid models
# answer HTTP 402 once it empties, and native web search is sold on paid models
# only. OPENROUTER_KEY is also accepted.
OPENROUTER_API_KEY=

# Direct provider keys, each routed only to its own provider. Models are read
# from each provider's own listing endpoint, so this file never names them.
OPENAI_API_KEY=
ANTHROPIC_API_KEY=
# Flash models answer free of charge, but Grounding with Google Search is not
# sold on the free tier: a free key measures visibility and returns no sources.
GEMINI_API_KEY=
# Sonar is web-grounded by the API, so every answer cites. Billed per request.
PERPLEXITY_API_KEY=
# No web search, so answers carry no citations.
DEEPSEEK_API_KEY=

# Optional server config.
# Set a password to require sign-in. Leave it empty and the server stays open,
# which is the existing behaviour and only safe on loopback or behind a proxy.
# Where to POST a digest when something moves. Nothing is sent when nothing
# changed, and a failed send leaves the baseline alone so the news is offered
# again rather than lost.
REPORT_WEBHOOK_URL=

# Encrypts provider keys entered through the portal. 32 bytes, base64 or hex.
# Generate one with:
#   node -e "console.log(require('crypto').randomBytes(32).toString('base64'))"
# Without it the portal refuses to store keys, because a key encrypted with a
# secret regenerated each boot would not survive a restart.
CREDENTIAL_KEY=

AUTH_PASSWORD=
# Signs session cookies. Generated fresh each boot when empty, so restarting
# signs everyone out. Set it to keep sessions across restarts.
AUTH_SECRET=

# Loopback by default because the app has no authentication.
# Set HOST=0.0.0.0 only behind an authenticating proxy.
# Combined-format access log, used to prove which AI crawlers actually fetched
# which pages. Without it, crawler analytics reports "not configured" rather
# than an empty result, because absence of a log is not absence of crawling.
# How often the worker re-probes a site's crawler access, llms.txt, schema and
# Wikidata presence. Default 24.
SIGNAL_PROBE_INTERVAL_HOURS=24

ACCESS_LOG_PATH=

HOST=127.0.0.1
PORT=8787
RUNS_DIR=runs

# Azure OpenAI. The endpoint is your resource root; deployments are the
# deployment names you created, since Azure exposes no listing for them.
AZURE_OPENAI_API_KEY=
AZURE_OPENAI_ENDPOINT=https://YOUR-RESOURCE.openai.azure.com
AZURE_OPENAI_API_VERSION=2024-10-21
AZURE_OPENAI_DEPLOYMENTS=gpt-4o-mini,gpt-4o

# Amazon Bedrock. Requests are signed here rather than through an SDK, so the
# region and the key pair are separate values and all of them are required.
# The models offered are whatever ListFoundationModels returns for this account
# in this region: access is granted per model, so one you have not enabled is
# listed by AWS and still answers a 403. No web search, so no citations.
# AWS_REGION, AWS_ACCESS_KEY_ID, AWS_SECRET_ACCESS_KEY and AWS_SESSION_TOKEN are
# read as fallbacks, so an environment that already has them needs nothing here.
AWS_BEDROCK_REGION=us-east-1
AWS_BEDROCK_ACCESS_KEY_ID=
AWS_BEDROCK_SECRET_ACCESS_KEY=
# Only temporary credentials have one. Leave it empty for a long-lived key.
AWS_BEDROCK_SESSION_TOKEN=

# Google Vertex AI. The credential is a service account key, not an API key: the
# key signs an assertion and Google exchanges it for a token on every run.
# Give the service account the Vertex AI User role on the project. The model id
# carries its publisher, as in google/gemini-2.5-pro or anthropic/claude-sonnet-4,
# and the models offered are whatever the region publishes. Google Search
# grounding is available per run and returns the pages an answer used, but
# Vertex refuses grounding alongside a response schema, so a schema wins.
GOOGLE_VERTEX_PROJECT_ID=
GOOGLE_VERTEX_LOCATION=us-central1
GOOGLE_VERTEX_CLIENT_EMAIL=
# The PEM from the service account key. A secret store that flattens newlines
# to the two characters backslash and n is read the same as a real newline.
GOOGLE_VERTEX_PRIVATE_KEY=

# Databricks model serving. The model id is the serving endpoint name your
# workspace gave it, not a vendor model name, and the listing is the only
# authority on which ones exist. No web search, so no citations.
DATABRICKS_HOST=
DATABRICKS_TOKEN=

# IBM watsonx.ai. The API key buys an IAM token, which is what the data plane
# actually takes. Models are listed per region, so one absent from the listing
# is absent from that region. No web search, so no citations.
WATSONX_REGION=eu-gb
WATSONX_PROJECT_ID=
WATSONX_API_KEY=

# Google, for Search Console and Analytics. One credential serves both, in
# either of two shapes: a service account key, or an OAuth client with a
# refresh token. Paste whichever you have; the shape is read from its fields.
GOOGLE_SERVICE_ACCOUNT_JSON=
GOOGLE_OAUTH_CREDENTIALS_JSON=
# The Search Console property exactly as Google spells it, scheme included.
GOOGLE_SEARCH_CONSOLE_SITE=
GOOGLE_ANALYTICS_PROPERTY_ID=

# Where a browser with remote debugging is listening, for the answer surfaces.
# It drives a browser you already have open and signed in; it starts nothing.
BROWSER_DEBUG_ENDPOINT=http://127.0.0.1:9222

# Telemetry. Nothing is exported unless an endpoint is set. The wire format is
# OTLP over HTTP with a JSON body, so any collector accepts it.
OTEL_EXPORTER_OTLP_ENDPOINT=
OTEL_SERVICE_NAME=citegeo
# Fraction of traces kept, decided from the trace id so it is consistent.
OTEL_TRACES_SAMPLER_ARG=1
LOG_LEVEL=info
LOG_FORMAT=json
